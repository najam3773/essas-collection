# Same-origin API prefix. Must stay /api — do not use a second API domain.
NEXT_PUBLIC_API_URL=/api
# Internal Express origin used by Next rewrites. Never expose this port publicly.
INTERNAL_API_URL=http://127.0.0.1:4000
# vinext/Workers Route Handlers: set to workers. Leave unset for Docker/Next Express proxy.
# STOREFRONT_API=workers
# JWT secrets belong in .dev.vars (gitignored), same names as ecom-backend/.env:
# JWT_SECRET=
# JWT_STAFF_SECRET=
# JWT_CUSTOMER_SECRET=
