POSTGRES_USER=platform
POSTGRES_PASSWORD=platform_secret
POSTGRES_DB=ecommerce
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_STAFF_SECRET=change-me-staff
JWT_CUSTOMER_SECRET=change-me-customer
# Aliases also accepted: STAFF_JWT_SECRET, CUSTOMER_JWT_SECRET
API_PORT=4000
API_HOST=127.0.0.1
WEB_URL=http://localhost:3000
NODE_ENV=development

# Image storage: local (development) or cloudinary (production)
IMAGE_STORAGE=local
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
