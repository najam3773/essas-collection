generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PlatformUser {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.Citext
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  auditLogs    PlatformAuditLog[]

  @@map("platform_users")
}

model SubscriptionPlan {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key               String   @unique
  name              String
  description       String?
  priceMonthlyCents Int      @default(0) @map("price_monthly_cents")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenants           Tenant[]
  planFeatures      PlanFeature[]
  subscriptions     TenantSubscription[]

  @@map("subscription_plans")
}

model Feature {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  name        String
  category    String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  planFeatures PlanFeature[]
  entitlements TenantEntitlement[]

  @@map("features")
}

model PlanFeature {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId     String  @map("plan_id") @db.Uuid
  featureKey String  @map("feature_key")
  enabled    Boolean @default(true)
  limitValue Int?    @map("limit_value")
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature    Feature @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@map("plan_features")
}

model Theme {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  themeKey         String   @unique @map("theme_key")
  name             String
  version          String   @default("1.0.0")
  industryTags     String[] @default([]) @map("industry_tags")
  requiredFeatures String[] @default([]) @map("required_features")
  layouts          String[] @default([])
  sections         String[] @default([])
  settingsSchema   Json     @default("{}") @map("settings_schema")
  previewUrl       String?  @map("preview_url")
  isPublished      Boolean  @default(false) @map("is_published")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  themeConfigs     ThemeConfig[]

  @@map("themes")
}

model FeatureService {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceKey           String   @unique @map("service_key")
  name                 String
  entitlementKey       String   @map("entitlement_key")
  requiredCoreFeatures String[] @default([]) @map("required_core_features")
  platformApiScopes    String[] @default([]) @map("platform_api_scopes")
  eventsPublish        String[] @default([]) @map("events_publish")
  eventsSubscribe      String[] @default([]) @map("events_subscribe")
  storefrontExtensions Json     @default("[]") @map("storefront_extensions")
  adminExtensions      Json     @default("[]") @map("admin_extensions")
  baseUrl              String?  @map("base_url")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("feature_services")
}

model Tenant {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String   @unique
  name             String
  status           String   @default("active")
  industryTemplate String?  @map("industry_template")
  planId           String?  @map("plan_id") @db.Uuid
  customDomain     String?  @unique @map("custom_domain")
  subdomain        String   @unique
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  plan             SubscriptionPlan? @relation(fields: [planId], references: [id])
  subscription     TenantSubscription?
  entitlements     TenantEntitlement[]
  featureLimits    TenantFeatureLimit[]
  screenOverrides  TenantScreenOverride[]
  roles            Role[]
  users            TenantUser[]
  customers        Customer[]
  categories       Category[]
  attributes       AttributeDefinition[]
  products         Product[]
  variants         ProductVariant[]
  inventory        InventoryItem[]
  carts            Cart[]
  cartItems        CartItem[]
  orders           Order[]
  orderLines       OrderLine[]
  payments         Payment[]
  shipments        Shipment[]
  themeConfig      ThemeConfig?
  pageSections     TenantPageSection[]
  contentPages     ContentPage[]
  menus            Menu[]
  menuItems        MenuItem[]
  shippingZones    ShippingZone[]
  taxRules         TaxRule[]
  coupons          Coupon[]
  webhooks         Webhook[]
  integrations     Integration[]
  auditLogs        TenantAuditLog[]
  addresses        CustomerAddress[]
  reviews          ProductReview[]
  wishlists        Wishlist[]
  wishlistItems    WishlistItem[]
  newsletterSubs   NewsletterSubscriber[]
  storeSettings    StoreSettings?
  discountRules    DiscountRule[]
  stockNotifications StockNotification[]
  productUpsells   ProductUpsell[]
  sales            Sale[]

  @@map("tenants")
}

model TenantSubscription {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @unique @map("tenant_id") @db.Uuid
  planId               String    @map("plan_id") @db.Uuid
  status               String    @default("active")
  currentPeriodStart   DateTime? @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz(6)
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("tenant_subscriptions")
}

model PlatformAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json     @default("{}")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      PlatformUser? @relation(fields: [actorId], references: [id])

  @@map("platform_audit_logs")
}

model TenantEntitlement {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  featureKey String   @map("feature_key")
  enabled    Boolean  @default(true)
  source     String   @default("plan")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature    Feature  @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([tenantId, featureKey])
  @@map("tenant_entitlements")
}

model TenantFeatureLimit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  limitKey  String   @map("limit_key")
  value     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, limitKey])
  @@map("tenant_feature_limits")
}

model TenantScreenOverride {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  screenKey String   @map("screen_key")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, screenKey])
  @@map("tenant_screen_overrides")
}

model Permission {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key      String @unique
  name     String
  category String

  @@map("permissions")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String
  name        String
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       TenantUser[]

  @@unique([tenantId, key])
  @@map("roles")
}

model RolePermission {
  roleId         String @map("role_id") @db.Uuid
  permissionKey  String @map("permission_key")
  scopeRule      String @default("tenant") @map("scope_rule")
  role           Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model TenantUser {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String   @db.Citext
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  roleId       String?  @map("role_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         Role?    @relation(fields: [roleId], references: [id])
  auditLogs    TenantAuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("tenant_users")
}

model Customer {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  email            String   @db.Citext
  passwordHash     String?  @map("password_hash")
  fullName         String?  @map("full_name")
  phone            String?
  isActive         Boolean  @default(true) @map("is_active")
  storeCreditCents Int      @default(0) @map("store_credit_cents")
  loyaltyPoints    Int      @default(0) @map("loyalty_points")
  customerGroupId  String?  @map("customer_group_id") @db.Uuid
  referralCode     String?  @unique @map("referral_code")
  referredBy       String?  @map("referred_by")
  membershipTierId String?  @map("membership_tier_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses        CustomerAddress[]
  carts            Cart[]
  orders           Order[]
  reviews          ProductReview[]
  wishlist         Wishlist?

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  label      String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String   @map("postal_code")
  country    String   @default("US")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String
  slug        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  sales       Sale[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("categories")
}

model AttributeDefinition {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  name                 String
  key                  String
  type                 String
  options              Json     @default("[]")
  appliesToCategories  String[] @default([]) @map("applies_to_categories") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("attribute_definitions")
}

enum PieceType {
  ONE_PIECE
  TWO_PIECE
  THREE_PIECE
  DUPATTA
}

model Product {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  categoryId     String?  @map("category_id") @db.Uuid
  name           String
  slug           String
  description    String?
  status         String   @default("draft")
  pieceType      PieceType @default(THREE_PIECE) @map("piece_type")
  media          Json     @default("[]")
  tags           String[] @default([])
  vendor         String?
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  featured       Boolean  @default(false)
  weightGrams    Int?     @map("weight_grams")
  isPreorder     Boolean  @default(false) @map("is_preorder")
  isDigital      Boolean  @default(false) @map("is_digital")
  isSubscription Boolean  @default(false) @map("is_subscription")
  requiresShipping Boolean @default(true) @map("requires_shipping")
  minQty         Int      @default(1) @map("min_qty")
  maxQty         Int?     @map("max_qty")
  downloadUrl    String?  @map("download_url")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       Category? @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  reviews        ProductReview[]
  wishlistItems  WishlistItem[]
  upsellsFrom    ProductUpsell[] @relation("UpsellSource")
  upsellsTo      ProductUpsell[] @relation("UpsellTarget")
  sales          Sale[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, pieceType])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  sku            String
  priceCents     Int      @map("price_cents")
  compareAtCents Int?     @map("compare_at_cents")
  attributeValues Json    @default("{}") @map("attribute_values")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory      InventoryItem[]
  cartItems      CartItem[]
  orderLines     OrderLine[]
  stockNotifications StockNotification[]

  @@unique([tenantId, sku])
  @@index([productId])
  @@map("product_variants")
}

model InventoryItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  variantId    String   @map("variant_id") @db.Uuid
  locationCode String   @default("default") @map("location_code")
  quantity     Int      @default(0)
  reserved     Int      @default(0)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, variantId, locationCode])
  @@map("inventory_items")
}

model Cart {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  customerId           String?   @map("customer_id") @db.Uuid
  sessionToken         String?   @map("session_token")
  currency             String    @default("USD")
  abandonedEmailSentAt DateTime? @map("abandoned_email_sent_at") @db.Timestamptz(6)
  recoveryToken        String?   @unique @map("recovery_token")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer             Customer? @relation(fields: [customerId], references: [id])
  items                CartItem[]

  @@index([tenantId])
  @@index([tenantId, sessionToken])
  @@map("carts")
}

model CartItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  cartId         String   @map("cart_id") @db.Uuid
  variantId      String   @map("variant_id") @db.Uuid
  quantity       Int
  unitPriceCents Int      @map("unit_price_cents")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Order {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  customerId      String?  @map("customer_id") @db.Uuid
  orderNumber     String   @map("order_number")
  status          String   @default("pending")
  currency        String   @default("USD")
  subtotalCents   Int      @default(0) @map("subtotal_cents")
  taxCents        Int      @default(0) @map("tax_cents")
  shippingCents   Int      @default(0) @map("shipping_cents")
  totalCents      Int      @default(0) @map("total_cents")
  discountCents   Int      @default(0) @map("discount_cents")
  couponCode      String?  @map("coupon_code")
  giftNote        String?  @map("gift_note")
  isDraft         Boolean  @default(false) @map("is_draft")
  fulfillmentMethod String @default("ship") @map("fulfillment_method")
  giftCardCents   Int      @default(0) @map("gift_card_cents")
  storeCreditCents Int     @default(0) @map("store_credit_cents")
  loyaltyPointsRedeemed Int @default(0) @map("loyalty_points_redeemed")
  referralCode    String?  @map("referral_code")
  shippingAddress Json?    @map("shipping_address")
  billingAddress  Json?    @map("billing_address")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer? @relation(fields: [customerId], references: [id])
  lines           OrderLine[]
  payments        Payment[]
  shipments       Shipment[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@map("orders")
}

model OrderLine {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  orderId         String  @map("order_id") @db.Uuid
  variantId       String? @map("variant_id") @db.Uuid
  productName     String  @map("product_name")
  sku             String
  quantity        Int
  unitPriceCents  Int     @map("unit_price_cents")
  attributeValues Json    @default("{}") @map("attribute_values")
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("order_lines")
}

model Payment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  provider    String   @default("stripe")
  providerRef String?  @map("provider_ref")
  amountCents Int      @map("amount_cents")
  status      String   @default("pending")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Shipment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  orderId        String    @map("order_id") @db.Uuid
  carrier        String?
  trackingNumber String?   @map("tracking_number")
  trackingUrl    String?   @map("tracking_url")
  notes          String?
  status         String    @default("pending")
  shippedAt      DateTime? @map("shipped_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

model ThemeConfig {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @unique @map("tenant_id") @db.Uuid
  themeId          String?  @map("theme_id") @db.Uuid
  brandName        String   @map("brand_name")
  logoUrl          String?  @map("logo_url")
  faviconUrl       String?  @map("favicon_url")
