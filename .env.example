# ============================================================
# Essa's Collection — environment (one web service)
# Copy values into Render / your local ecom-backend/.env
# Never commit real secrets.
# ============================================================

# Neon PostgreSQL (pooled URL is fine for the app)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Unpooled Neon URL for Prisma schema push. If omitted, startup copies DATABASE_URL.
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Auth secrets — generate long random strings in production
JWT_SECRET=
JWT_STAFF_SECRET=
JWT_CUSTOMER_SECRET=
# Aliases also accepted:
# STAFF_JWT_SECRET=
# CUSTOMER_JWT_SECRET=

# Public site origin (Render URL, no trailing slash)
WEB_URL=https://essas-collection.onrender.com

# Internal Express only — never expose this port on Render
API_PORT=4000
API_HOST=127.0.0.1

# Same-origin browser API. Must stay /api (do not use a second API domain)
NEXT_PUBLIC_API_URL=/api
INTERNAL_API_URL=http://127.0.0.1:4000

# Render sets PORT. Do not hardcode 3000 in production.
# PORT=10000

NODE_ENV=production

# Images: local (dev) or cloudinary (production)
IMAGE_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
